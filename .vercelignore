# Vercel upload ignore rules (reduces deploy size). Vercel will still run the build
# and generate the `dist/` output on its builders.

# Mobile native projects (not needed for web deploy)
android/
ios/

# Backend/runtime stuff not needed for the web-only deploy
backend-runtime/
email-backend/

# VCS / editor / OS metadata
.git/
.github/
.vscode/
.idea/
**/.DS_Store
*.pem

# dependencies
node_modules/
.venv

# expo
.expo/
.expo-export/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# metro
.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
firestore-debug.log
email-backend/logs/

# Firebase CLI local deploy cache (regenerated per machine)
.firebase/

# Firebase Service Account Keys - NEVER COMMIT/UPLOAD THESE!
serviceAccountKey.json
firebase-service-account.json
scripts/serviceAccountKey.json
scripts/firebase-service-account.json
*-service-account*.json
*serviceAccount*.json
.tmp-service-account.json
backend-runtime/firebase_sa.b64
email-backend/firebase_sa.b64

# local env files (secrets stay off Vercel's upload; real values come from Vercel project env vars)
.env
.env*.local
.env.*
!.env.example
eas.json

# local runtime artifacts (keep local, don't commit/upload)
reports/
.tmp/
.kiro/

# typescript
*.tsbuildinfo
.vercel

# android builds
*.apk
*.aab
android/app/build/
android/build/
android/.gradle/
android/local.properties

# iOS build directories and artifacts
ios/build/
ios/DerivedData/
ios/Pods/
*.ipa
*.xcarchive
ios/*.xcodeproj/xcuserdata/
ios/*.xcworkspace/xcuserdata/
*.xcuserstate

# expo export archives
dist/**/*.tar.gz
web-build/**/*.tar.gz

# coverage reports
coverage/
backend-runtime/coverage/
**/.turbo/
**/.next/

# Firebase/Google config and locks (do not commit/upload)
android/app/google-services.json
app/google-services.json
package-lock.json

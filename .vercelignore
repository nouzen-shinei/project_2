# Vercel upload ignore rules (reduces deploy size). Vercel will still run the build
# and generate the `dist/` output on its builders.

# Mobile native projects (not needed for web deploy)
android/
ios/

# Local deps and caches
node_modules/
.expo/
.expo-export/
.expo-shared/

# Web build output (generated during Vercel build)
dist/

# Local build artifacts
*.apk
*.aab
*.ipa
*.xcarchive

# Backend/runtime stuff not needed for the web-only deploy
backend-runtime/
email-backend/

# Misc
**/.DS_Store
**/coverage/
**/.turbo/
**/.next/



# dependencies
node_modules/

.venv

# expo
.expo/
.expo-export/
dist/
web-build/
expo-env.d.ts
.expo-shared/

# native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macos
.DS_Store
*.pem

# Firebase Service Account Keys - NEVER COMMIT THESE!
serviceAccountKey.json
firebase-service-account.json
scripts/serviceAccountKey.json
scripts/firebase-service-account.json
*-service-account*.json
*serviceAccount*.json
backend-runtime/firebase_sa.b64
email-backend/firebase_sa.b64

# local env files
.env
.env*.local
.env.*
!.env.example
eas.json

# local runtime artifacts (keep local, don't commit)
reports/
firestore-debug.log
email-backend/logs/

# typescript
*.tsbuildinfo
.vercel

# android builds
*.apk
*.aab

# android build directories and config
android/app/build/
android/build/
android/.gradle/
android/local.properties

# iOS build directories and artifacts
ios/build/
ios/DerivedData/
ios/Pods/
*.ipa
*.xcarchive

# additional signing artifacts
*.keystore

# iOS Xcode project/workspace noise
ios/*.xcodeproj/xcuserdata/
ios/*.xcworkspace/xcuserdata/
*.xcuserstate

# expo export archives
dist/**/*.tar.gz
web-build/**/*.tar.gz

# coverage reports
coverage/
backend-runtime/coverage/

# Firebase/Google config and locks (do not commit)
android/app/google-services.json
app/google-services.json
package-lock.json
# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_client_id_here
# Native/legacy client IDs (optional but recommended for native builds)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Web Google sign-in flow: set to 'redirect' to force the full-page redirect flow.
# Anything else (including unset) uses the default popup flow.
EXPO_PUBLIC_WEB_GOOGLE_AUTH_MODE=

# Firebase Configuration  
# Get these from Firebase Console > Project Settings > Web App
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Expo / EAS Project Configuration
# Set at least one of these so native builds can register for push notifications
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id
# Optional fallbacks used by EAS CLI/build infrastructure
EAS_PROJECT_ID=
EAS_BUILD_PROJECT_ID=
EXPO_PUBLIC_PROJECT_ID=

# GIF/Sticker Provider Configuration (chat GIF & sticker picker)
# Tenor was discontinued by Google (https://developers.google.com/tenor) and is no longer supported.
# Giphy is preferred when both providers are enabled; Klipy is used as an automatic
# fallback (and vice versa) if the preferred provider's key is missing, disabled, or
# temporarily failing. Set the corresponding *_ENABLED flag to 0 to force-disable a
# provider even when its API key is present. At least one provider should be configured.
#
# Get a Giphy API key from https://developers.giphy.com/
EXPO_PUBLIC_GIPHY_API_KEY=your_giphy_api_key_here
EXPO_PUBLIC_GIPHY_ENABLED=1

# Get a Klipy API key from https://klipy.com/developers
EXPO_PUBLIC_KLIPY_API_KEY=your_klipy_api_key_here
EXPO_PUBLIC_KLIPY_ENABLED=1

# Runtime & Logging Controls
# BUILD_ENV toggles dev/staging/prod feature gates in the client (default: development)
EXPO_PUBLIC_BUILD_ENV=development
# LOG_LEVEL controls logger verbosity (debug, info, warn, error)
EXPO_PUBLIC_LOG_LEVEL=debug
# Set to 1 to silence non-error logs globally; KEEP_WARN=1 preserves warnings when logs are disabled
EXPO_PUBLIC_DISABLE_LOGS=0
EXPO_PUBLIC_KEEP_WARN=0
# Force debug logs to use console.log on web (helps when browsers hide console.debug)
EXPO_PUBLIC_FORCE_DEBUG_TO_LOG=0

# Debug Toggles
# When 1/true, enables extra auth/network diagnostics on-device
EXPO_PUBLIC_DEBUG_AUTH=0
EXPO_PUBLIC_DEBUG_SLOW=0
# Enable SSE/WebSocket realtime chat stream (fallback to legacy polling when 0)
EXPO_PUBLIC_CHAT_STREAM_ENABLED=1
# Emit render-count metrics for chat bubbles when enabled (defaults off)
EXPO_PUBLIC_CHAT_PROFILE_MESSAGES=0
# Emit frame timing metrics for chat surfaces when enabled (defaults off)
EXPO_PUBLIC_CHAT_PROFILE_FRAMES=0

# API Endpoints
# Primary backend base URL the app should call
EXPO_PUBLIC_API_BASE_URL=https://api.your_app.com
# Optional dedicated endpoints for WhatsApp, email, notifications, or network probes
EXPO_PUBLIC_WABA_API_BASE_URL=
EXPO_PUBLIC_CHAT_API_BASE_URL=https://api.your_app.com/
EXPO_PUBLIC_EMAIL_API_BASE_URL=
EXPO_PUBLIC_NOTIFICATIONS_API_BASE_URL=
EXPO_PUBLIC_CONNECTIVITY_TEST_URL=https://api.your_app.com/healthz
# Backend base URL used to mint PUBLIC share links (falls back to
# EXPO_PUBLIC_API_BASE_URL, then to the cached Firestore runtimeEndpoints).
# Share-link creation throws if none of the three resolve.
EXPO_PUBLIC_PUBLIC_API_BASE_URL=

# Admin & web app URLs surfaced in emails/alerts
EXPO_PUBLIC_ADMIN_BASE_URL=https://admin.your_app.com
EXPO_PUBLIC_APP_URL=
EXPO_PUBLIC_APP_BASE_URL=
# Public web app origin. Also read server-side by backend-runtime as the last
# fallback for invite/share deep links (after WEB_APP_BASE_URL and
# PUBLIC_WEB_APP_ORIGIN) before the hardcoded default.
EXPO_PUBLIC_WEB_APP_URL=
# Extra hostnames the /l smart-link redirector may send users to, comma-separated.
# Empty/unset ⇒ same-origin absolute URLs only, which is what prevents open-redirect
# abuse. Add hosts only when you control them.
EXPO_PUBLIC_SMARTLINK_ALLOWED_HOSTS=
# WhatsApp Business (WABA) delivery is fully backend-handled via the queue.
# The client only needs the backend base URL (EXPO_PUBLIC_WABA_API_BASE_URL above,
# seeded into Firestore appSettings/runtimeEndpoints.wabaApiBaseUrl). No client-side
# WhatsApp phone-number id or access token is used or supported anymore.

# Release Metadata surfaced in settings screens
EXPO_PUBLIC_APP_VERSION=
EXPO_PUBLIC_APP_BUILD=
EXPO_PUBLIC_RELEASE_MONTH=
EXPO_PUBLIC_RELEASE_DATE=

# Coaching / brand label overrides
EXPO_PUBLIC_COACHING_NAME=

# Temporary reviewer quick join (public, non-secret)
EXPO_PUBLIC_REVIEWER_QUICK_JOIN_ENABLED=0
EXPO_PUBLIC_REVIEWER_QUICK_JOIN_CODE=
EXPO_PUBLIC_REVIEWER_QUICK_JOIN_CENTER_NAME=legacy-coachin

# Presence (client-side)
# Set how to derive online status in the app: 'last_seen' (default) or 'flag'
#  - last_seen: a user is online if lastSeen is within EXPO_PUBLIC_FIRESTORE_ONLINE_THRESHOLD_MIN minutes
#  - flag: trusts the stored isOnline field in Firestore
EXPO_PUBLIC_PRESENCE_MODE=last_seen

# Enable server-driven chat deltas (1 to enable)
EXPO_PUBLIC_CHAT_DELTAS_ENABLED=1

# Tenant used for chat preferences (pinned chats) before a tenant is selected.
# Default when unset: legacy-coaching
EXPO_PUBLIC_DEFAULT_TENANT_ID=legacy-coaching

# Threshold (in minutes) used when PRESENCE_MODE=last_seen. Supports decimals, e.g. 0.5 = 30 seconds
EXPO_PUBLIC_FIRESTORE_ONLINE_THRESHOLD_MIN=0.5

# Chat pagination overrides (leave blank to use defaults)
EXPO_PUBLIC_CHAT_PAGE_SIZE=
EXPO_PUBLIC_CHAT_BOOTSTRAP_PAGES=
EXPO_PUBLIC_CHAT_CACHE_LIMIT=
EXPO_PUBLIC_CHAT_PREFETCH_THRESHOLD=
# Native-specific overrides (take precedence over shared values)
EXPO_PUBLIC_CHAT_PAGE_SIZE_NATIVE=
EXPO_PUBLIC_CHAT_BOOTSTRAP_PAGES_NATIVE=
EXPO_PUBLIC_CHAT_CACHE_LIMIT_NATIVE=
EXPO_PUBLIC_CHAT_PREFETCH_THRESHOLD_NATIVE=
# Web-specific overrides
EXPO_PUBLIC_CHAT_PAGE_SIZE_WEB=
EXPO_PUBLIC_CHAT_BOOTSTRAP_PAGES_WEB=
EXPO_PUBLIC_CHAT_CACHE_LIMIT_WEB=
EXPO_PUBLIC_CHAT_PREFETCH_THRESHOLD_WEB=

# ─── Chat media: keyboard/clipboard paste + kill-safe background upload ────────
# Native keyboard/clipboard media paste (send stickers/GIFs/images straight from
# the keyboard's GIF/sticker button or the OS clipboard). Set to `true` to
# FORCE-DISABLE the native paste module and fall back to a plain text input (an
# escape hatch, e.g. if a future RN upgrade regresses it). Default (unset) = enabled.
EXPO_PUBLIC_DISABLE_NATIVE_MEDIA_PASTE=false
# True background upload (kill-safe media, Phase 2). When `true`, sticker/GIF/keyboard
# media uploads continue — and the chat message is created server-side — even if the
# app is backgrounded or killed mid-upload (via rn-background-upload + the backend
# `/storage/upload?createMessage=1` path). Requires a native rebuild AND the backend
# deployed with that change. Default (unset/false) = off: uses the foreground upload
# path, which is still durable via the offline/resume outbox. Falls back to foreground
# automatically if the native module is unavailable.
EXPO_PUBLIC_ENABLE_BG_UPLOAD=false

# ─── PWA / service worker (web only) ──────────────────────────────────────────
# The service worker is normally registered only in production or on
# localhost/127.0.0.1. Set to exactly `true` to also register it on a non-local
# dev host (e.g. testing the PWA over a LAN IP or tunnel). Default off.
EXPO_PUBLIC_ENABLE_DEV_SERVICE_WORKER=false

# Feature flags follow the pattern EXPO_PUBLIC_FF_<FLAG_NAME>=1

# DO NOT SET CLIENT SECRET FOR PUBLIC CLIENTS (MOBILE/WEB)
# Client secrets should only be used on secure server environments
# For public clients, we use PKCE (Proof Key for Code Exchange) for security

# IMPORTANT REDIRECT URIs TO ADD IN GOOGLE CLOUD CONSOLE:
# - https://auth.expo.io/@anonymous/bolt-expo-nativewind  
# - com.sneha.tution://auth
# - exp://localhost:8081/--/auth
# - http://localhost:8081/auth
# - http://localhost:19006/auth (for web development)
# - https://localhost:19006/auth (for web development with HTTPS)

# ─── Local admin/maintenance scripts (scripts/*.js|ts, run from the repo root) ─
# These are NOT part of the client bundle. They are Admin-SDK fallbacks used only
# when you run the one-off scripts locally; the deployed backend reads its own
# copies from backend-runtime/.env. Leave blank unless you are running a script.
#
# Service account for the Admin SDK. Prefer `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
# Project ID fallbacks (checked before EXPO_PUBLIC_FIREBASE_PROJECT_ID, then
# 'demo-project' in several scripts).
FIREBASE_PROJECT_ID=
GCLOUD_PROJECT=
# Realtime Database URL fallback chain used by the tenant-report/backfill scripts:
# FIREBASE_DATABASE_URL, then FIREBASE_DB_URL, then DATABASE_URL.
FIREBASE_DATABASE_URL=
FIREBASE_DB_URL=
DATABASE_URL=
# Non-EXPO_PUBLIC fallbacks used by scripts/initGlobalSettings.js when seeding the
# Firestore runtimeEndpoints document.
API_BASE_URL=
EMAIL_API_BASE_URL=
# Emulator targets. Set these to run the scripts/integration tests against local
# emulators instead of the real project.
FIRESTORE_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=
# scripts/auditAndUpdateAppInfo.js writes to Firestore unless this is exactly
# 'false' (i.e. unset means it WILL write).
UPDATE_FIRESTORE=
# Allow the app-info update scripts to create the settings document when it does
# not exist yet. Any non-empty value enables it.
CREATE_IF_MISSING=
#
# scripts/runScheduledUsageRollup.ts, scripts/processUsageRefreshRequests.ts and
# scripts/escalateUsageAlerts.ts are thin wrappers around the backend jobs and read
# the same USAGE_ROLLUP_* / USAGE_REFRESH_* / USAGE_ALERT_* variables. They are
# documented once, in backend-runtime/.env.example — set them there, or export them
# in your shell for a one-off local run.
#
# NODE_ENV is read by config/firebase.js, hooks/useAuthUnified.ts and lib/pwa.ts but
# is set by the toolchain (expo/metro/jest). Do not set it here.

# ─── Video transcoding (H.265 → H.264 for browser compatibility) ───────────────
# Set both flags to false to fully disable transcoding. When disabled, videos that
# a browser cannot decode show a "format not supported" message instead of being
# transcoded, and no transcode jobs are scheduled. Videos transcoded before
# disabling continue to play. Accepted disable values: false, 0, no, off, disabled.
# Default (unset) = enabled.
#
# Backend (server) flag — authoritative gate:
VIDEO_TRANSCODE_ENABLED=true
# Frontend (client) flag — keep in sync with the backend flag:
EXPO_PUBLIC_VIDEO_TRANSCODE_ENABLED=true

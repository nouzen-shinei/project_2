{
  "name": "tuition-management-app",
  "main": "expo-router/entry",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "prestart": "node scripts/verifyEnv.js --profile development",
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build": "npm run build:web",
    "prebuild:preview": "node scripts/verifyEnv.js --profile preview && node scripts/enforceProdEnv.js preview",
    "prebuild:production": "node scripts/verifyEnv.js --profile production && node scripts/enforceProdEnv.js production",
    "build:web": "node scripts/verifyEnv.js --profile production && node scripts/enforceProdEnv.js production && expo export --platform web && node scripts/stripHtmlComments.mjs dist && node scripts/generateStyleScriptHashes.mjs dist csp-hashes.json",
    "pwa:assets": "pwa-asset-generator public/pwa/icon-512.png public/pwa --icon-only --scrape false --type png --padding \"8%\" --background \"transparent\" --opaque false --log false && node scripts/fixTransparentPngRgb.mjs 0 0 0 public/pwa/apple-icon-180.png public/pwa/manifest-icon-192.maskable.png public/pwa/manifest-icon-512.maskable.png",
    "lint": "expo lint",
    "test:unit": "node scripts/runTests.js",
    "migrate:logs": "ts-node scripts/migrateLogsToLogger.ts",
    "postinstall": "patch-package || true",
    "setup:firestore": "node scripts/setupFirestoreManual.js",
    "setup:data": "node scripts/setupFirestoreData.js",
    "setup:data-force": "node scripts/setupFirestoreData.js --force",
    "clear:data": "node scripts/setupFirestoreData.js clear",
    "data:status": "node scripts/setupFirestoreData.js status",
    "test:firestore": "node scripts/testFirestore.js",
    "app:status": "node scripts/appStatus.js",
    "deploy:firestore": "node scripts/deployFirestore.js",
    "init:settings": "node scripts/initSettings.js",
    "init:settings-cli": "node scripts/initFirestoreSettings.js --cli",
    "init:settings-sdk": "node scripts/initFirestoreSettings.js",
    "update:appinfo": "node scripts/updateAppInfoExtended.js",
    "init:global-settings": "node scripts/initGlobalSettings.js",
    "verify:appinfo": "node scripts/verifyAppInfoExtended.js",
    "firestore:set-runtime-endpoints": "node scripts/setRuntimeEndpoints.js",
    "update:appinfo-full": "node scripts/updateAppInfoFull.js",
    "audit:appinfo": "node scripts/auditAndUpdateAppInfo.js",
    "audit:appinfo-only": "UPDATE_FIRESTORE=false node scripts/auditAndUpdateAppInfo.js",
    "usage:rollup": "ts-node scripts/rollupTenantUsage.ts",
    "usage:refresh-worker": "ts-node scripts/processUsageRefreshRequests.ts",
    "usage:rollup:scheduled": "ts-node scripts/runScheduledUsageRollup.ts",
    "usage:alerts:escalate": "ts-node scripts/escalateUsageAlerts.ts",
    "audit:tenant-coverage": "ts-node scripts/reportTenantCoverage.ts",
    "compare:coverage": "ts-node scripts/compareCoverageReports.ts",
    "migration:run": "ts-node scripts/runTenantMigrationPlan.ts",
    "delete:tenant-data": "ts-node scripts/deleteTenantData.ts",
    "upload:admin": "node scripts/uploadWithAdminSDK.js",
    "upload:admin-force": "node scripts/uploadWithAdminSDK.js --force",
    "version:bump:patch": "node scripts/bumpVersion.js patch",
    "version:bump:minor": "node scripts/bumpVersion.js minor",
    "version:bump:major": "node scripts/bumpVersion.js major",
    "version:set": "node scripts/bumpVersion.js set",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/server": "^0.6.3",
    "@expo/vector-icons": "^14.1.0",
    "@expo/webpack-config": "^19.0.1",
    "@lucide/lab": "^0.1.2",
    "@mattermost/react-native-paste-input": "0.8.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@shopify/flash-list": "1.7.6",
    "ajv": "^8.17.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.2",
    "expo": "~53.0.25",
    "expo-application": "~6.1.5",
    "expo-audio": "~0.4.9",
    "expo-auth-session": "~6.2.1",
    "expo-blur": "~14.1.3",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.10",
    "expo-clipboard": "^7.1.5",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.3",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "^18.1.11",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.3",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "^16.1.4",
    "expo-intent-launcher": "~12.1.5",
    "expo-linear-gradient": "~14.1.3",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-location": "^18.1.6",
    "expo-media-library": "~17.1.7",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.10",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "^13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.2",
    "expo-symbols": "~0.4.3",
    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.17",
    "expo-video": "~2.2.2",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.2.1",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-alert-async": "^1.0.5",
    "react-native-blob-util": "^0.19.11",
    "react-native-calendars": "^1.1313.0",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-iap": "^14.7.0",
    "react-native-nitro-modules": "^0.32.0",
    "react-native-pdf": "^6.7.6",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "rn-background-upload": "0.1.0",
    "tailwindcss": "^3.4.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "baseline-browser-mapping": "^2.9.2",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~9.2.0",
    "fast-check": "^4.8.0",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.16.0",
    "jest": "^29.7.0",
    "metro": "^0.82.4",
    "metro-config": "^0.82.4",
    "patch-package": "^8.0.0",
    "pngjs": "^7.0.0",
    "pwa-asset-generator": "^8.1.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@expo/config-plugins": "~10.1.1",
    "@expo/metro-config": "0.20.18"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "crypto-js"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}

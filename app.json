{
  "expo": {
    "name": "Tuition Manager",
    "slug": "bolt-expo-nativewind",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.sneha.tution",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sneha.tution",
      "associatedDomains": [
        "applinks:tuitionmanager.app"
      ],
      "buildNumber": "20250902"
    },
    "android": {
      "package": "com.sneha.tution",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tuitionmanager.app",
              "pathPrefix": "/shared/"
            },
            {
              "scheme": "https",
              "host": "tuitionmanager.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "versionCode": 20251113,
      "googleServicesFile": "./app/google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.ico",
      "template": "./web/index.html"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/Inter_400Regular.ttf",
            "assets/fonts/Inter_500Medium.ttf",
            "assets/fonts/Inter_600SemiBold.ttf",
            "assets/fonts/Inter_700Bold.ttf",
            "assets/fonts/Poppins_400Regular.ttf",
            "assets/fonts/Poppins_500Medium.ttf",
            "assets/fonts/Poppins_600SemiBold.ttf",
            "assets/fonts/Poppins_700Bold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "applyGoogleServicesPlugin": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification icons/notification-icon.png",
          "color": "#1A73E8",
          "defaultChannel": "general_notifications",
          "sounds": [],
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-secure-store"
    ],
    "updates": {
      "url": "https://u.expo.dev/54825f56-767a-447c-95bc-b425f7227775"
    },
    "runtimeVersion": "1.1.3",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "54825f56-767a-447c-95bc-b425f7227775"
      }
    }
  }
}

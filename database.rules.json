{
  "rules": {
    "tenantChat": {
      "$tenantId": {
        ".write": false,
        "conversationMessages": {
          "$conversation": {
            ".read": "auth != null && ($conversation.beginsWith(auth.token.email.toLowerCase().replace('@','_').replace('.','_') + '__') || $conversation.endsWith('__' + auth.token.email.toLowerCase().replace('@','_').replace('.','_')))",
            ".indexOn": ["timestamp", "sender", "recipientId", "read", "delivered"],
            "$messageId": {
              ".validate": "newData.hasChildren(['sender', 'timestamp']) && (!(newData.hasChild('sender') && newData.hasChild('recipientId')) || newData.child('sender').val() != newData.child('recipientId').val())",
              "sender": { ".validate": "newData.isString() && newData.val().length <= 320 && newData.val() == auth.token.email" },
              "recipientId": { ".validate": "newData.isString() && newData.val().length <= 320" },
              "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
              "clientMsgId": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "read": { ".validate": "newData.isBoolean()" },
              "delivered": { ".validate": "newData.isBoolean()" },
              "timestamp": { ".validate": "newData.isString() || newData.isNumber()" },
              "$other": { ".validate": true }
            }
          }
        },
        "messageIndex": {
          ".read": "auth != null",
          ".indexOn": ["timestamp", "conversationKey", "recipientId", "sender"]
        },
        "conversationClientMsgIndex": {
          ".read": false,
          ".write": false,
          "$conversation": {
            ".indexOn": [".value"]
          }
        },
        "conversationSummaries": {
          "$user": {
            ".read": "auth != null && $user === auth.token.email.toLowerCase().replace('@','_').replace('.','_')",
            "$partner": {
              ".indexOn": ["updatedAt", "partnerEmail"]
            }
          }
        },
        "conversationLatest": {
          "$conversation": {
            ".read": "auth != null && ($conversation.beginsWith(auth.token.email.toLowerCase().replace('@','_').replace('.','_') + '__') || $conversation.endsWith('__' + auth.token.email.toLowerCase().replace('@','_').replace('.','_')))",
            ".indexOn": ["timestamp"]
          }
        },
        "userConversations": {
          "$user": {
            ".read": "auth != null && $user === auth.token.email.toLowerCase().replace('@','_').replace('.','_')",
            ".indexOn": ["updatedAt", "partnerEmail"]
          }
        },
        "typing": { ".read": false, ".write": false },
        "messageReactions": { ".read": false, ".write": false }
      }
    },
    "chatRateLimit": {
      ".read": false,
      ".write": false
    }
  }
}

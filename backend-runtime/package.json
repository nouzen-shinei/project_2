{
  "name": "whatsapp-backend-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test:run": "node --test tests/*.test.mjs",
    "test": "npm run build && c8 --reporter=text --reporter=lcov --check-coverage --lines=30 --statements=30 --branches=25 --functions=35 npm run test:run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "usage:rollup:scheduled": "node dist/jobs/runScheduledUsageRollup.js",
    "usage:refresh-worker": "node dist/jobs/processUsageRefreshRequests.js",
    "billing:backfill": "node dist/jobs/runBillingBackfill.js",
    "billing:play-reconcile": "node dist/jobs/runPlayBillingReconcile.js",
    "billing:stale-pending": "node dist/jobs/runBillingAutoCancelStalePending.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.3.0",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.17.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "bullmq": "^5.10.4",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pdfkit": "^0.17.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "c8": "^9.1.0",
    "eslint": "^8.57.0",
    "typescript": "^5.9.2"
  }
}

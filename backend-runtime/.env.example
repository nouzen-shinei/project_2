###############################################
# Backend Runtime Environment (.env example) #
# Copy to .env and fill in real values.      #
# Never commit real secrets to version ctrl. #
###############################################

# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port the Express server listens on (default 8080).
PORT=8080
# Set to 'production' in prod, 'development' locally, 'test' in CI.
NODE_ENV=development
# Internal test mode — bypasses rate limits and some external calls (never set in prod).
TEST_MODE=0
# Graceful shutdown timeout in ms (default 10000).
SHUTDOWN_TIMEOUT_MS=10000

# ─── Master internal API key ──────────────────────────────────────────────────
# Used to mint short-lived HMAC tokens for internal endpoints.
# Generate with: openssl rand -hex 32
# SECURITY (REQUIRED in prod): when NODE_ENV=production and this is unset, the API
# fails CLOSED — every request except /health and /ready returns 503. Also used as
# the operator/global-admin master credential; never expose it to clients.
INTERNAL_API_KEY=replace_me_strong_random

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=

# Service account credentials — provide ONE of the following:
# Option A: raw JSON string (recommended for containers / Fly secrets)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: path to a service account JSON file
FIREBASE_SERVICE_ACCOUNT=
# Option C: base64-encoded JSON string (alternative aliases also accepted)
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_ADMIN_CREDENTIALS_B64=  # alias
# FIREBASE_SA_B64=                 # alias
# Option D: base64 file on disk (legacy default, checked if nothing above is set)
FIREBASE_SERVICE_ACCOUNT_FILE=./backend-runtime/firebase_sa.b64
# FIREBASE_SERVICE_ACCOUNT_PATH=  # alias for FIREBASE_SERVICE_ACCOUNT_FILE
# FIREBASE_SA_PATH=               # alias read by the usage-rollup job's initFirebase
# Standard GCP application-default credentials (local dev with gcloud login)
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json

# Firebase Realtime Database URL (required for chat / RTDB write-backs).
# Aliases: FIREBASE_DB_URL, FIREBASE_RTDB_URL, EXPO_PUBLIC_FIREBASE_DATABASE_URL
# REQUIRED by the storage orphan sweep, which REFUSES TO START without it (before
# initialising Firebase, before any listing or read). Chat attachments are
# referenced ONLY from the Realtime Database, so a sweep without a database handle
# would enumerate no chat references and report the whole of chat-files/ — the
# largest prefix in the bucket — as unreferenced.
FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com

# Firebase Storage bucket name (required for file uploads / video transcoding).
# Alias: EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET
# Also REQUIRED by the storage orphan sweep, which REFUSES TO START without it: an
# unnamed bucket makes every stored reference resolve as foreign_bucket, leaving an
# empty retain set and reporting an entire tenant as orphaned.
FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Default '*' (open).
# SECURITY (prod): set an explicit allowlist — the server logs a startup warning
# when this is '*'/unset in production. Auth is bearer-token (not cookies), so '*'
# is lower-risk, but pin it to your real web origins.
# Example: CORS_ALLOW_ORIGINS=https://tuitionmanager.app,https://admin.tuitionmanager.app
CORS_ALLOW_ORIGINS=*

# ─── Video transcoding (H.265 → H.264 for browser compatibility) ─────────────
# Master on/off switch for the transcoding pipeline. When disabled, no transcode
# jobs are scheduled and /video/request-transcode returns { status: 'disabled' }.
# Videos transcoded before disabling continue to play. Unsupported videos show a
# "format not supported" message. Accepted disable values: false, 0, no, off, disabled.
# Default (unset) = enabled.
VIDEO_TRANSCODE_ENABLED=true

# Maximum number of ffmpeg transcode jobs that may run concurrently per process.
# 0 = unlimited. Default 1 (prevents OOM on Fly.io 1 GB machines).
# Increase with caution — each H.265 job peaks at ~400 MB RSS.
MAX_CONCURRENT_TRANSCODES=1

# ─── WhatsApp Business API ────────────────────────────────────────────────────
WABA_PHONE_NUMBER_ID=add_a_number
WABA_TOKEN=replace_with_prod_long_lived_token
# Default country code (digits only) for WhatsApp number normalisation.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Webhook verification token + Meta app secret for signature validation.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_meta_verify_token
META_APP_SECRET=replace_with_meta_app_secret
# Optional header media URL or media ID for birthday WhatsApp template.
BIRTHDAY_WHATSAPP_IMAGE_URL=https://example.com/path/to/birthday-image.jpg

# ─── Queue / processing ───────────────────────────────────────────────────────
WHATSAPP_QUEUE_CONCURRENCY=4
WHATSAPP_QUEUE_NAME=wa-reminders
JOB_RETENTION_MS=604800000
JOB_AUDIT_FILE=./jobs-audit.json
# How long a finished job stays in the in-memory job map (default 1800000 = 30 min).
JOB_IN_MEMORY_RETENTION_MS=1800000
# How often the in-memory job map is swept for expired entries (default 60000 = 1 min).
JOB_EVICT_INTERVAL_MS=60000

# ─── BullMQ (optional — uses in-memory queue when unset) ─────────────────────
USE_BULLMQ=false
REDIS_URL=redis://redis:6379

# ─── Web Push (required for closed-browser web notifications) ────────────────
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Recommended format: mailto:ops@example.com
WEB_PUSH_VAPID_SUBJECT=mailto:support@tuitionmanager.app

# ─── Chat messaging ───────────────────────────────────────────────────────────
# Message edit/delete windows (configurable per environment).
# Accept SECONDS or MS; if both set, SECONDS takes precedence.
CHAT_MESSAGE_EDIT_WINDOW_SECONDS=300
# CHAT_MESSAGE_EDIT_WINDOW_MS=300000
CHAT_MESSAGE_DELETE_WINDOW_SECONDS=300
# CHAT_MESSAGE_DELETE_WINDOW_MS=300000

# Chat rate limits. Set CHAT_RATE_LIMIT_DISABLED=1 to disable entirely (dev only).
CHAT_RATE_LIMIT_DISABLED=0
# Short window: max 20 messages per 60 s per user.
CHAT_RATE_LIMIT_SHORT_WINDOW_MS=60000
CHAT_RATE_LIMIT_SHORT_MAX=20
# Long window: max 60 messages per 5 min per user.
CHAT_RATE_LIMIT_LONG_WINDOW_MS=300000
CHAT_RATE_LIMIT_LONG_MAX=60

# TTL in ms for the cached live participant/member counts (default 10000).
# 0 disables the cache.
LIVE_COUNT_CACHE_TTL_MS=10000

# ─── Tenant caches ───────────────────────────────────────────────────────────
# Membership lookup cache: TTL in ms (default 45000, floor 5000) and max entries
# (default 1000, floor 100).
TENANT_MEMBERSHIP_CACHE_MS=45000
TENANT_MEMBERSHIP_CACHE_MAX=1000
# Tenant metadata (name/slug/status) cache TTL in ms (default 30000).
TENANT_METADATA_CACHE_TTL_MS=30000

# ─── Expiry sweepers (invites / join codes / join requests) ──────────────────
# Each sweeper runs on its own interval and pages through expired docs.
# INTERVAL_MS default 3600000 (1 hour); set to 0 to disable that sweeper.
# BATCH_SIZE default 200; clamped to [1, 500] (the Firestore batched-write limit).
INVITE_EXPIRY_SWEEP_INTERVAL_MS=3600000
INVITE_EXPIRY_SWEEP_BATCH_SIZE=200
JOIN_CODE_EXPIRY_SWEEP_INTERVAL_MS=3600000
JOIN_CODE_EXPIRY_SWEEP_BATCH_SIZE=200
JOIN_REQUEST_EXPIRY_SWEEP_INTERVAL_MS=3600000
JOIN_REQUEST_EXPIRY_SWEEP_BATCH_SIZE=200

# ─── Expo push ───────────────────────────────────────────────────────────────
# Override the Expo push endpoint (default https://exp.host/--/api/v2/push/send).
EXPO_PUSH_ENDPOINT=
# Timeout in ms for the /push proxy route (default 10000).
EXPO_PUSH_PROXY_TIMEOUT_MS=10000

# ─── Presence sweeper ────────────────────────────────────────────────────────
# Interval in ms to run the presence cleanup loop (default 300000 = 5 minutes).
PRESENCE_SWEEP_INTERVAL_MS=300000
# Minutes after which a user is considered stale/offline (default 5).
PRESENCE_STALE_MINUTES=5
# Firestore collection to sweep for presence flags (default tenantPresence).
PRESENCE_COLLECTION=tenantPresence
# Query mode: 'online_only' (default, efficient) or 'full_scan' (exhaustive).
PRESENCE_SWEEP_QUERY_MODE=online_only

# ─── Email backend ────────────────────────────────────────────────────────────
# URL of the email-backend service that exposes POST /email/send-template.
EMAIL_BACKEND_BASE_URL=https://my-email-backend.fly.dev
# Must match the email-backend service's INTERNAL_API_KEY (sent as x-internal-key).
EMAIL_BACKEND_INTERNAL_KEY=
# Alternative auth (leave unset unless email-backend uses bearer auth).
EMAIL_BACKEND_BEARER=
# Dedicated least-privilege secret the email-backend uses to authenticate its
# reminder-history callback (POST /internal/reminder-history/email-result) via the
# x-reminder-callback-key header. Set this to a strong random value and configure
# the SAME value as REMINDER_CALLBACK_KEY on the email-backend. When set, the
# email-backend no longer needs the master key (INTERNAL_API_KEY) for the callback.
REMINDER_CALLBACK_KEY=
# Admin/web URLs used to build deep links in emails.
ADMIN_PORTAL_BASE_URL=
ADMIN_JOIN_REQUEST_PATH=/admin/settings/join-requests
# Path appended to ADMIN_PORTAL_BASE_URL for usage-alert deep links.
ADMIN_USAGE_PANEL_PATH=/admin/settings/usage
# Public web app origin used to build user-facing links (invites, share links).
# Resolution order: WEB_APP_BASE_URL, then PUBLIC_WEB_APP_ORIGIN, then
# EXPO_PUBLIC_WEB_APP_URL, then the hardcoded default https://tuitionmanager.app.
WEB_APP_BASE_URL=
PUBLIC_WEB_APP_ORIGIN=
# Tenant invite links. BASE_URL falls back to the resolved web app base URL.
TENANT_INVITE_BASE_URL=
TENANT_INVITE_PATH=/invite

# ─── Reviewer quick-join auto-approval ───────────────────────────────────────
# Temporary feature for automated App Review accounts. Disabled by default.
# SECURITY: when enabled, a matching join code auto-grants tenant membership (up to
# `admin`, never `owner`). Keep DISABLED in normal prod; only enable during an app
# review window, use a high-entropy REVIEWER_AUTO_APPROVE_JOIN_CODE, scope it with
# the tenant guards below, and unset both vars once review completes.
REVIEWER_AUTO_APPROVE_ENABLED=0
REVIEWER_AUTO_APPROVE_JOIN_CODE=
# Optional tenant guards to prevent accidental cross-tenant auto-approval.
REVIEWER_AUTO_APPROVE_TENANT_ID=
REVIEWER_AUTO_APPROVE_TENANT_SLUG=
# Allowed values: member, staff, admin (default: member)
REVIEWER_AUTO_APPROVE_ROLE=member
REVIEWER_AUTO_APPROVE_ACTOR_NAME="Reviewer quick join"

# ─── Birthday notifications ──────────────────────────────────────────────────
# Toggle the daily birthday-runner on/off (default: enabled).
BIRTHDAY_NOTIFICATIONS_ENABLED=true
# Run once shortly after startup (useful after deploys / tests).
BIRTHDAY_NOTIFICATIONS_RUN_ON_START=true
# Delay in ms before the startup run triggers (default 15000).
BIRTHDAY_NOTIFICATIONS_START_DELAY_MS=0
# Dry run: log intended deliveries without calling Expo (default false).
BIRTHDAY_NOTIFICATIONS_DRY_RUN=false
# Emit completion stats to logs after each run.
BIRTHDAY_NOTIFICATIONS_LOG_STATS=true
# Override sender name in push messages; falls back to Firestore coachingName.
BIRTHDAY_NOTIFICATION_SENDER_NAME="S.S Tuition Classes"
# Cache duration in ms for the coaching name lookup (default 300000 = 5 min).
BIRTHDAY_COACHING_NAME_CACHE_MS=300000
# Firestore collection storing tenant member profiles (default tenantProfiles).
BIRTHDAY_PROFILE_COLLECTION=tenantProfiles
# Default tenant ID for legacy (non-multi-tenant) coaching data.
BIRTHDAY_DEFAULT_TENANT_ID=legacy-coaching
# Brand/coaching name fallback chain for push copy:
# COACHING_NAME, then EXPO_PUBLIC_COACHING_NAME, then the Firestore lookup.
COACHING_NAME=

# ─── Daily quote notifications ────────────────────────────────────────────────
DAILY_QUOTES_ENABLED=true
# Scheduler mode: 'time_of_day' (run at fixed morning/evening slots)
#                 'interval' (run every DAILY_QUOTES_INTERVAL_MS)
DAILY_QUOTES_SCHEDULER_MODE=time_of_day
# Timezone for the scheduler slots.
DAILY_QUOTES_DEFAULT_TIMEZONE=Asia/Kolkata
# Morning/evening slot times (0–23 / 0–59).
DAILY_QUOTES_MORNING_HOUR=8
DAILY_QUOTES_MORNING_MINUTE=0
DAILY_QUOTES_EVENING_HOUR=20
DAILY_QUOTES_EVENING_MINUTE=0
# Delivery window in minutes after the slot time (per-device local time).
DAILY_QUOTES_WINDOW_MINUTES=90
# Interval mode frequency (ms).
DAILY_QUOTES_INTERVAL_MS=300000
# Optional: force a run shortly after startup (still respects delivery windows).
DAILY_QUOTES_RUN_ON_START=false
DAILY_QUOTES_START_DELAY_MS=15000
# Catch-up run if the service starts during an active slot window.
DAILY_QUOTES_CATCHUP_ON_START=true
DAILY_QUOTES_CATCHUP_DELAY_MS=10000
DAILY_QUOTES_WINDOW_EARLY_GRACE_SECONDS=10
# Debug overrides — force delivery to a specific device/token for testing.
DAILY_QUOTES_DEBUG_TOKEN=
DAILY_QUOTES_DEBUG_DEVICE_ID=
DAILY_QUOTES_DEBUG_EMAIL=
# Timeout in ms for the upstream quote API call (default 5000; clamped 1000..20000).
DAILY_QUOTES_API_TIMEOUT_MS=5000
# Device-scan page size when selecting delivery targets (default 500; clamped 50..2000).
DAILY_QUOTES_DEVICE_SCAN_PAGE_SIZE=500

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me_twilio_auth
TWILIO_PHONE_NUMBER=+15555555555
# Optional HMAC secret used to sign outbound Twilio payloads. Unset ⇒ no signature
# is attached (the signing helper returns null).
TWILIO_SIGNING_SECRET=

# ─── APNs (direct Apple Push, optional but recommended for iOS reliability) ───
# Provide APNS_AUTH_KEY_PATH or APNS_AUTH_KEY_B64.
APNS_BUNDLE_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
APNS_AUTH_KEY_B64=
# true = production APNs endpoint, false = sandbox.
APNS_PRODUCTION=true

# ─── Alert thresholds ────────────────────────────────────────────────────────
ALERT_QUEUE_DEPTH=50
ALERT_FAILURE_RATE=0.05
ALERT_HTTP_ERROR_RATE_5M=0.05
ALERT_HTTP_5XX_5M=25
ALERT_HTTP_P95_MS_5M=2000
ALERT_RUNTIME_EVENT_LOOP_P99_MS=100
ALERT_CHAT_REALTIME_WATCHES_ACTIVE=50
ALERT_CHAT_REALTIME_WATCH_SUBSCRIBERS=200
# Alert when a scheduled job's last-run age exceeds this many hours.
# Leave blank/unset to disable the individual staleness alert.
ALERT_BILLING_PLAY_RECONCILE_STALE_HOURS=
ALERT_DAILY_QUOTES_STALE_HOURS=

# Billing alert thresholds (leave blank/unset to disable individual alerts).
ALERT_BILLING_SIGNATURE_FAILURES_15M=1
ALERT_BILLING_INVALID_JSON_15M=1
ALERT_BILLING_HANDLER_FAILURES_15M=1
ALERT_BILLING_INVOICE_WRITE_FAILURES_15M=1
ALERT_BILLING_STATE_WRITE_FAILURES_15M=1
ALERT_BILLING_UNKNOWN_EVENTS_24H=10
# Alert when the billing backfill last-run age exceeds this many hours.
ALERT_BILLING_BACKFILL_STALE_HOURS=30

# ─── Metrics ──────────────────────────────────────────────────────────────────
# Comma-separated counter names for rolling-window calculations.
# Leave blank to use the default billing allowlist from metrics.ts.
METRICS_WINDOWED_NAMES=

# ─── CSP ──────────────────────────────────────────────────────────────────────
CSP_VIOLATION_RETENTION_DAYS=7
CSP_VIOLATION_PRUNE_INTERVAL_MS=3600000
CSP_HASHES_PATH=./csp-hashes.json
# Set to 1 to always serve CSP as Report-Only (never enforced).
CSP_REPORT_ONLY_MODE=0

# ─── Billing feature flags ────────────────────────────────────────────────────
# Enable webhook endpoints (/billing/*/webhook).
BILLING_WEBHOOKS_ENABLED=0
# Enforce delinquency access restrictions after the grace period.
BILLING_DELINQUENCY_ENFORCEMENT_ENABLED=0
BILLING_DELINQUENCY_GRACE_DAYS=7
# Automatically downgrade delinquent tenants to Free once grace expires.
# Set to 0 to return 402 billing_past_due instead.
BILLING_AUTO_DOWNGRADE_AFTER_GRACE=1
# Enable App Store / Play Store billing endpoints.
STORE_BILLING_ENABLED=0
# Per-tenant checkout lock TTL in minutes.
BILLING_CHECKOUT_LOCK_TTL_MINUTES=15
# Hosted checkout UI origin.
BILLING_CHECKOUT_BASE_URL=https://billing.tuitionmanager.app/checkout
# Local web testing override (comment out in prod):
# BILLING_CHECKOUT_BASE_URL=http://localhost:8081/checkout

# ─── Device tenant-index (scoped device listing + backfill) ─────────────────
# Denormalizes a per-device `tenantIndex` so the Device Console can list a
# tenant's devices with an indexed `array-contains` query instead of scanning
# every device in the project.
#
# Safe rollout order (no downtime; each step is independently reversible):
#   1. Deploy the Firestore composite index + security rules.
#   2. Deploy the backend — the write path starts maintaining `tenantIndex`
#      on every device write, keeping the index fresh going forward.
#   3. Run the one-shot backfill for pre-existing devices:
#        node dist/jobs/runDeviceTenantIndexBackfill.js
#   4. Flip DEVICE_TENANT_INDEX_LISTING_ENABLED=1 to serve the scoped path.
#   Unset the flag to instantly revert to the proven full scan.
#
# Gates the scoped indexed device listing. 0/unset = use the proven full-scan
# fallback; 1 = use the scoped `array-contains` query. NOTE: it only takes
# effect AFTER the backfill has recorded completion (the code forces the
# fallback until then), and it transparently falls back to the full scan if the
# Firestore index is unavailable. Default off.
DEVICE_TENANT_INDEX_LISTING_ENABLED=0
# Backfill page size (docs read + rewritten per batch). Default 300; clamped to
# <= 500 (the Firestore batched-write limit).
DEVICE_TENANT_INDEX_BACKFILL_BATCH_SIZE=300
# Re-run the backfill even if it already recorded completion. Idempotent — it
# skips docs whose index is already correct. Accepts 1/true/yes. Default off.
DEVICE_TENANT_INDEX_BACKFILL_FORCE=0
# Attribution string recorded on the backfill progress doc. Falls back to
# GITHUB_SHA / USER / 'local-dev' when unset.
DEVICE_TENANT_INDEX_BACKFILL_RUNNER_ID=local-dev

# ─── Offline-device prune (backend maintenance job) ─────────────────────────
# Scheduled Admin-SDK job that HARD-DELETES device docs
# (`user_devices/{email}/devices/{id}`) whose last-seen is older than a
# threshold. Restores the long-offline device cleanup that used to run
# client-side (removed because it required global cross-user scans/writes now
# denied by the locked Firestore rules). Hard delete is safe: `/devices/ping`
# uses set(merge:true) so a returning device self-recreates a clean doc, and
# tenant history lives in the independent append-only `deviceAuditLogs`. The job
# writes NO per-device audit rows; its run summary is the progress doc
# `deviceMaintenanceJobs/offlineDevicePrune`.
#
# Safe rollout (every knob defaults to SAFE — disabled + dry-run):
#   1. Leave disabled. Nothing scans or deletes.
#   2. Enable ONCE in dry-run to review the counts on the progress doc:
#        OFFLINE_DEVICE_PRUNE_ENABLED=1   (DRY_RUN stays 1)
#        node dist/jobs/runOfflineDevicePrune.js
#   3. Once the counts look right, actually delete:
#        OFFLINE_DEVICE_PRUNE_DRY_RUN=0
#        node dist/jobs/runOfflineDevicePrune.js
#   4. Schedule it via the existing cron/runner mechanism (npm run
#      device:offline-prune).
#
# Opt-in master switch. 0/unset = the runner logs "disabled" and exits 0 WITHOUT
# scanning or deleting anything. 1/true/yes = run. Default off.
OFFLINE_DEVICE_PRUNE_ENABLED=0
# Dry-run. 1/unset = scan + count what WOULD be deleted, delete NOTHING. Only an
# explicit 0/false/no performs deletes. Default on (safe).
OFFLINE_DEVICE_PRUNE_DRY_RUN=1
# Staleness threshold in days: a device last seen before (now - N days) is
# pruned. A device with an UNKNOWN last-seen is never pruned. Default 14.
OFFLINE_DEVICE_PRUNE_MAX_AGE_DAYS=14
# Page size (docs read per batch; deletes staged per batch in apply mode).
# Default 300; clamped to [1, 500] (the Firestore batched-write limit).
OFFLINE_DEVICE_PRUNE_BATCH_SIZE=300
# Re-run even if a completion state is already recorded (bypasses the idempotent
# no-op). Accepts 1/true/yes. Default off.
OFFLINE_DEVICE_PRUNE_FORCE=0
# Attribution string recorded on the prune progress doc. Falls back to
# GITHUB_SHA / USER / 'local-dev' when unset.
OFFLINE_DEVICE_PRUNE_RUNNER_ID=local-dev

# ─── Storage orphan sweep (backend maintenance job) ─────────────────────────
# Scheduled Admin-SDK job that finds Storage objects no record references any
# more, MOVES them to a `quarantine/` prefix (never deletes in the sweep itself),
# and — under a separate switch — hard-deletes quarantine copies once their
# retention window has expired. Its run summary is the progress doc
# `storageMaintenanceJobs/storageOrphanSweep`; report mode mutates nothing outside
# `storageMaintenanceJobs/`. Run with `npm run storage:orphan-sweep`.
#
# Parsing rules that apply to EVERY variable below, because both are non-obvious
# and safety-relevant:
#   * Booleans: only `1`, `true` and `yes` parse as TRUE (case-insensitive, after
#     trimming). Anything else — including `on`, `y`, a typo, an empty value or an
#     unset variable — is FALSE. Every switch here defaults to FALSE.
#   * Numerics: a value that parses non-finite, non-positive, OR truncates to zero
#     (e.g. `0.5`) falls back to its documented default, NEVER to zero. This
#     matters most for GRACE_DAYS: a graceDays of 0 would report every
#     unreferenced object regardless of age, silently turning off the protection
#     for the non-atomic gap between a successful upload and its record write.
#
# Safe rollout (every knob defaults to SAFE — disabled + report mode):
#   1. Leave disabled. Nothing initialises Firebase, lists or reads.
#   2. Enable ONCE in report mode and read `countsBySource` and
#      `sampleOrphanPaths` on the progress doc by eye:
#        STORAGE_ORPHAN_SWEEP_ENABLED=1   (APPLY stays 0)
#        node dist/jobs/runStorageOrphanSweep.js
#   3. Apply with a LOW per-tenant cap, then restore one object by hand to prove
#      the recovery path:
#        STORAGE_ORPHAN_SWEEP_APPLY=1
#        STORAGE_ORPHAN_SWEEP_MAX_QUARANTINE_PER_TENANT=25
#   4. Raise the cap once the counts and a manual restore both look right.
#   5. Enable the purge ONLY after the retention window has passed.
#   Rollback at any point: STORAGE_ORPHAN_SWEEP_ENABLED=0.
#
# Opt-in master switch. 0/unset = the runner logs its decision and exits 0 WITHOUT
# initialising Firebase — so a disabled job cannot list, read or write anything at
# all. 1/true/yes = run. This is also the rollback. Default off.
STORAGE_ORPHAN_SWEEP_ENABLED=0
# The destructive switch. 0/unset = report mode, which mutates nothing outside
# `storageMaintenanceJobs/`. 1 = quarantine orphans. Independent of ENABLED on
# purpose, so no single mistyped variable can move an object. Default off.
STORAGE_ORPHAN_SWEEP_APPLY=0
# The IRREVERSIBLE stage: hard-delete of quarantine copies whose retention has
# expired. A separate switch on a separate entrypoint, and it needs APPLY as well
# to delete rather than count. Redundant with the GCS lifecycle rule in
# `infra/storage/quarantine-lifecycle.json`, which does not depend on this job
# running. Default off.
STORAGE_ORPHAN_SWEEP_PURGE_ENABLED=0
# Re-run a tenant already recorded `completed`, from the first prefix with fresh
# counters. Accepts 1/true/yes. Default off.
STORAGE_ORPHAN_SWEEP_FORCE=0
# Grace period in days: objects touched within this window are retained
# regardless of references, which is what protects the non-atomic gap between a
# successful upload and its record write. Default 7 — and a bad value falls back
# to 7, never to 0.
STORAGE_ORPHAN_SWEEP_GRACE_DAYS=7
# How long a quarantined object stays recoverable via `restoreFromQuarantine`.
# Keep in sync with the GCS lifecycle rule's `age: 7`. Default 7.
STORAGE_ORPHAN_SWEEP_QUARANTINE_RETENTION_DAYS=7
# Comma-separated tenant allow-list. Empty/unset ⇒ every tenant with
# status == 'active'. Blank and duplicate entries are dropped.
STORAGE_ORPHAN_SWEEP_TENANT_IDS=
# Per-tenant per-run move ceiling — the blast radius of one bad run. Reaching it
# ends the tenant with `abortReason: 'quarantine_cap_reached'` and a resume
# cursor, so the remainder is a deliberate second run. Default 1000.
STORAGE_ORPHAN_SWEEP_MAX_QUARANTINE_PER_TENANT=1000
# Object-listing page size. Only one page is held at a time, so the resident cost
# is the retain set, not the bucket. Default 1000.
STORAGE_ORPHAN_SWEEP_PAGE_SIZE=1000
# Retain-set ceiling. Exceeding it ABORTS the tenant rather than proceeding on
# partial knowledge, because a truncated retain set is indistinguishable from a
# set of orphans. Default 2000000.
STORAGE_ORPHAN_SWEEP_MAX_REFERENCES=2000000
# Attribution string recorded on the sweep report document. Falls back to
# GITHUB_SHA / USER / USERNAME / 'local-dev' when unset.
STORAGE_ORPHAN_SWEEP_RUNNER_ID=local-dev

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SECURITY: REQUIRED when BILLING_WEBHOOKS_ENABLED=1. The Razorpay webhook fails
# CLOSED (503 webhook_secret_not_configured) if this is unset outside test mode —
# it will NOT process unverified payloads. Set to the webhook secret from the
# Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_EXPIRE_MINUTES=15
# Razorpay plan ID for the Pro monthly tier (required to create subscriptions).
RAZORPAY_PLAN_ID_PRO_MONTHLY=
# Number of billing cycles requested when creating a subscription (default 360).
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=360

# ─── Google Play Billing ──────────────────────────────────────────────────────
# JSON service account credentials for Google Play Developer API.
# Accepts raw JSON (starts with '{') or base64(JSON).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_PRODUCT_ID_PRO_MONTHLY=
# Pub/Sub OIDC audience for Real-time Developer Notifications (RTDN).
# SECURITY: REQUIRED when STORE_BILLING_ENABLED=1. The RTDN endpoint fails CLOSED
# (503 rtdn_oidc_not_configured) if this is unset outside test mode — it will NOT
# accept unverified Pub/Sub pushes. Set to the full push endpoint URL.
PLAY_RTDN_OIDC_AUDIENCE=

# Play subscription reconciliation (safety net for missed RTDN).
PLAY_BILLING_RECONCILE_ENABLED=0
PLAY_BILLING_RECONCILE_INTERVAL_MS=21600000
PLAY_BILLING_RECONCILE_RUN_ON_START=0
PLAY_BILLING_RECONCILE_START_DELAY_MS=30000
PLAY_BILLING_RECONCILE_TENANT_IDS=
PLAY_BILLING_RECONCILE_MAX_TENANTS=200
PLAY_BILLING_RECONCILE_DRY_RUN=0
PLAY_BILLING_RECONCILE_VERBOSE=0
# Distributed lock (prevents concurrent runs on multi-machine deployments).
PLAY_BILLING_RECONCILE_LOCK_ENABLED=1
PLAY_BILLING_RECONCILE_LOCK_DOC=billingLocks/play_billing_reconcile
PLAY_BILLING_RECONCILE_LOCK_LEASE_MS=900000
# Recommended production baseline (example for ~10k Play subscribers):
# PLAY_BILLING_RECONCILE_ENABLED=1
# PLAY_BILLING_RECONCILE_INTERVAL_MS=900000
# PLAY_BILLING_RECONCILE_RUN_ON_START=1
# PLAY_BILLING_RECONCILE_START_DELAY_MS=60000
# PLAY_BILLING_RECONCILE_MAX_TENANTS=500
# PLAY_BILLING_RECONCILE_LOCK_LEASE_MS=3600000

# ─── App Store Billing ────────────────────────────────────────────────────────
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_P8=
APPSTORE_BUNDLE_ID=
APPSTORE_PRODUCT_ID_PRO_MONTHLY=

# ─── Usage analytics rollups ──────────────────────────────────────────────────
# Target specific tenants (comma-separated) or leave blank to scan all.
USAGE_ROLLUP_TENANT_IDS=
# Month override in YYYY-MM format; defaults to current month when unset.
USAGE_ROLLUP_MONTH=
# Set to 1 to reprocess historical docs (backfill).
USAGE_ROLLUP_BACKFILL=0
# Set to 1 to skip writes (validate queries only).
USAGE_ROLLUP_DRY_RUN=0
# Set to 1 to require writes — fails fast if DRY_RUN is also set.
USAGE_ROLLUP_REQUIRE_WRITE=0
USAGE_ROLLUP_VERBOSE=0
USAGE_ROLLUP_JOB_LABEL=usage_rollup_scheduler
# Runner attribution in Firestore records (falls back to GITHUB_SHA / USER).
ROLLUP_RUNNER_ID=local-dev
# How many tenants are rolled up in parallel (default 4, floor 1).
USAGE_ROLLUP_TENANT_CONCURRENCY=4
# Per-source opt-outs. Set to 1/true/yes to skip that source entirely — the
# resulting rollup is PARTIAL, so use them only to isolate a slow/failing source.
USAGE_ROLLUP_SKIP_REMINDERS=0
USAGE_ROLLUP_SKIP_PAYMENTS=0
USAGE_ROLLUP_SKIP_CHAT=0
USAGE_ROLLUP_SKIP_STORAGE=0
# Set to 1 to skip the reminder-usage reconciliation pass in the API process.
DISABLE_REMINDER_USAGE_RECONCILE=0

# Storage stats mirroring (optional — for analytics dashboards).
USAGE_STORAGE_STATS_COLLECTION=usage_storage_stats
# Extra Firestore prefixes to scan (comma-separated).
USAGE_STORAGE_EXTRA_PREFIXES=

# Usage alerting + escalation.
USAGE_ALERT_SENDER_NAME="Usage Monitor"
USAGE_ALERT_BRAND_NAME="Tuition Manager"
# Hours to suppress repeat alerts for the same metric (min 1).
USAGE_ALERT_THROTTLE_HOURS=24
USAGE_ALERT_DEBUG=0
USAGE_ALERT_SLACK_WEBHOOK_URL=
USAGE_ALERT_ESCALATION_BATCH_LIMIT=10
USAGE_ALERT_ESCALATION_MAX_ATTEMPTS=3
USAGE_ALERT_ACK_ESCALATION_WARNING_HOURS=12
USAGE_ALERT_ACK_ESCALATION_CRITICAL_HOURS=24
# Days before an unchanged, still-unacknowledged alert is re-sent (default 7, floor 1).
USAGE_ALERT_UNCHANGED_REMINDER_DAYS=7

# Usage refresh worker tuning.
USAGE_REFRESH_BATCH_LIMIT=25
USAGE_REFRESH_DRY_RUN=0
USAGE_REFRESH_VERBOSE=0

# ─── Billing backfill / reconciliation (Razorpay) ────────────────────────────
BILLING_BACKFILL_TENANT_IDS=
BILLING_BACKFILL_MAX_TENANTS=250
BILLING_BACKFILL_MAX_PAYMENTS_PER_SUBSCRIPTION=200
BILLING_BACKFILL_DRY_RUN=0
BILLING_BACKFILL_VERBOSE=0
BILLING_BACKFILL_JOB_LABEL=billing_backfill
# Falls back to GITHUB_SHA / USER when unset.
BILLING_BACKFILL_RUNNER_ID=local-dev

# Backfill scheduler (runs the backfill job periodically inside backend-runtime).
BILLING_BACKFILL_SCHEDULER_ENABLED=0
BILLING_BACKFILL_SCHEDULER_RUN_ON_START=0
BILLING_BACKFILL_SCHEDULER_START_DELAY_MS=30000
BILLING_BACKFILL_SCHEDULER_INTERVAL_MS=86400000
BILLING_BACKFILL_SCHEDULER_DRY_RUN=0

# ─── Billing stale-pending auto-cancel ───────────────────────────────────────
BILLING_STALE_PENDING_TENANT_IDS=
BILLING_STALE_PENDING_MAX_TENANTS=200
# Hours since checkout issuedAt before auto-cancel (clamped 1..168).
BILLING_STALE_PENDING_THRESHOLD_HOURS=24
BILLING_STALE_PENDING_DRY_RUN=0
BILLING_STALE_PENDING_VERBOSE=0
BILLING_STALE_PENDING_JOB_LABEL=billing_stale_pending
# Per-tenant lease in ms (clamped 30s..30m).
BILLING_STALE_PENDING_TENANT_LEASE_MS=180000
# Run-level lease in ms — prevents concurrent scheduler runs on multi-machine deployments.
# Clamped 30s..6h. Recommended for 1000+ tenants: 7200000 (2h).
BILLING_STALE_PENDING_RUN_LEASE_MS=7200000

# ─── Injected by the platform / shell (read-only — do NOT set these manually) ─
# FLY_MACHINE_ID  — Fly.io: distributed lock holder identification
# HOSTNAME        — fallback when FLY_MACHINE_ID is absent
# GITHUB_SHA      — CI: first fallback for every *_RUNNER_ID attribution string
# USER / USERNAME — shell: second/third fallback for *_RUNNER_ID
# JEST_WORKER_ID  — Jest: presence marks the process as a test process, which
#                   suppresses the background sweepers/schedulers
# NODE_TEST_CONTEXT — node:test: same purpose as JEST_WORKER_ID

# ─── Logging ──────────────────────────────────────────────────────────────────
# Passed to child/worker processes. The main server uses its own log config.
LOG_LEVEL=info

# ─── DO NOT COMMIT REAL SECRETS TO VERSION CONTROL ───────────────────────────

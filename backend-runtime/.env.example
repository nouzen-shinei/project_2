###############################################
# Backend Runtime Environment (.env example)  #
# Copy to .env and fill in real values.       #
###############################################

# Master internal API key (used to mint short-lived HMAC tokens for internal endpoints)
INTERNAL_API_KEY=replace_me_strong_random

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional path to a base64-encoded service account file (defaults to backend-runtime/firebase_sa.b64)
FIREBASE_SERVICE_ACCOUNT_FILE=./backend-runtime/firebase_sa.b64

# WhatsApp Business API (server-side only)
WABA_PHONE_NUMBER_ID=add_a_number
WABA_TOKEN=replace_with_prod_long_lived_token
# Optional default country code (digits only) for WhatsApp number normalization
HATSAPP_DEFAULT_COUNTRY_CODE=91
# Optional header media for birthday WhatsApp template (URL or media ID)
BIRTHDAY_WHATSAPP_IMAGE_URL=https://example.com/path/to/birthday-image.jpg

# Webhook verification + signature
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_meta_verify_token
META_APP_SECRET=replace_with_meta_app_secret

# Queue / processing
WHATSAPP_QUEUE_CONCURRENCY=4
WHATSAPP_QUEUE_NAME=wa-reminders
JOB_RETENTION_MS=604800000
JOB_AUDIT_FILE=./jobs-audit.json

# Web Push (required for closed-browser web notifications)
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Recommended format: mailto:ops@example.com
WEB_PUSH_VAPID_SUBJECT=mailto:support@tuitionmanager.app

# CORS (comma-separated origins). '*' allows all (default). Example for prod restriction:
# CORS_ALLOW_ORIGINS=https://tuitionmanager.app

# Alert thresholds
ALERT_QUEUE_DEPTH=50
ALERT_FAILURE_RATE=0.05

# Billing alert-style thresholds (optional)
# These drive extra gauge lines in GET /metrics (in-memory rolling window counts).
# Set to blank/unset to disable each alert.
ALERT_BILLING_SIGNATURE_FAILURES_15M=1
ALERT_BILLING_INVALID_JSON_15M=1
ALERT_BILLING_HANDLER_FAILURES_15M=1
ALERT_BILLING_INVOICE_WRITE_FAILURES_15M=1
ALERT_BILLING_STATE_WRITE_FAILURES_15M=1
ALERT_BILLING_UNKNOWN_EVENTS_24H=10
# Backfill freshness (scheduler-only): alert when last run age exceeds this many hours.
# If no run has happened yet, the alert triggers.
ALERT_BILLING_BACKFILL_STALE_HOURS=30

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# BullMQ (optional)
USE_BULLMQ=false
REDIS_URL=redis://redis:6379

# Email backend (required for join-request + membership-role-change emails)
# Points to the email-backend service that exposes POST /email/send-template
EMAIL_BACKEND_BASE_URL=https://my-email-backend.fly.dev
# Must match the email-backend service's INTERNAL_API_KEY (sent as x-internal-key)
EMAIL_BACKEND_INTERNAL_KEY=
# Alternative auth option (leave unset unless you configured bearer auth on email-backend)
EMAIL_BACKEND_BEARER=

# Admin/web URLs used to build deep links in some emails (optional)
# If unset, links may be omitted from email payloads.
ADMIN_PORTAL_BASE_URL=
ADMIN_JOIN_REQUEST_PATH=/admin/settings/join-requests

# Temporary reviewer quick join auto-approval (server-side)
# When enabled, only the configured join code is auto-approved after normal code checks pass.
REVIEWER_AUTO_APPROVE_ENABLED=0
REVIEWER_AUTO_APPROVE_JOIN_CODE=
# Optional tenant guards to avoid accidental cross-tenant auto-approval
REVIEWER_AUTO_APPROVE_TENANT_ID=
REVIEWER_AUTO_APPROVE_TENANT_SLUG=
# Allowed values: member, staff, admin (default: member)
REVIEWER_AUTO_APPROVE_ROLE=member
REVIEWER_AUTO_APPROVE_ACTOR_NAME="Reviewer quick join"

# Logging (optional future variables)
# LOG_LEVEL=info

# Presence sweeper (optional)
# Interval in ms to run the presence cleanup loop (default 300000 = 5 minutes)
PRESENCE_SWEEP_INTERVAL_MS=300000
# Minutes after which a user is considered stale/offline (default 5)
PRESENCE_STALE_MINUTES=5
# Collection name to sweep for presence flags (default authorizedEmails)
PRESENCE_COLLECTION=authorizedEmails

# Twilio (server-side only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me_twilio_auth
TWILIO_PHONE_NUMBER=+15555555555

# Direct APNs (server-side only, optional but recommended for iOS reliability)
# Set these to enable direct Apple Push Notification service delivery.
# You can provide either APNS_AUTH_KEY_PATH or APNS_AUTH_KEY_B64.
APNS_BUNDLE_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
APNS_AUTH_KEY_B64=
# true => production APNs, false => sandbox
APNS_PRODUCTION=true

# Billing feature flags
# Enable webhook endpoints (/billing/*/webhook)
BILLING_WEBHOOKS_ENABLED=0
# Enforce delinquency access restrictions (after grace period) for paid tenants.
# Note: Billing endpoints remain accessible so tenants can recover by paying.
BILLING_DELINQUENCY_ENFORCEMENT_ENABLED=0
# Number of days after becoming delinquent before restricting access.
BILLING_DELINQUENCY_GRACE_DAYS=7
# Automatically downgrade delinquent tenants to Free once grace expires.
# Set to 0 to keep the older behavior (return 402 billing_past_due after grace).
BILLING_AUTO_DOWNGRADE_AFTER_GRACE=1
# Enable store billing endpoints (/billing/play/*, /billing/appstore/*)
STORE_BILLING_ENABLED=0

# Prevent multiple admins from starting payment at the same time.
# When a checkout is started, the backend creates a per-tenant lock that blocks new checkouts until it expires.
# Webhooks clear the lock automatically when a billing event is received for the tenant.
BILLING_CHECKOUT_LOCK_TTL_MINUTES=15

# Billing UI / redirect base (used by POST /billing/checkout)
# This is the hosted checkout UI origin you control.
BILLING_CHECKOUT_BASE_URL=https://billing.tuitionmanager.app/checkout

# Local web-only testing (optional):
BILLING_CHECKOUT_BASE_URL=http://localhost:8081/checkout

# Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map plan IDs to Stripe Price IDs
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=

# Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_EXPIRE_MINUTES=15

# Google Play Billing (server-side only)
# JSON service account credentials for Google Play Developer API.
# Accepts either:
# - Raw JSON (starts with '{')
# - base64(JSON)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Android package name (applicationId)
GOOGLE_PLAY_PACKAGE_NAME=
# Product/subscription IDs configured in Play Console
GOOGLE_PLAY_PRODUCT_ID_PRO_MONTHLY=

# Google Play RTDN (Real-time Developer Notifications)
# Pub/Sub push -> POST /billing/play/notifications
# If set, the backend requires a Pub/Sub OIDC token whose audience matches this value.
# Recommended: set to the full push endpoint URL, e.g.
#   https://your-backend.fly.dev/billing/play/notifications
PLAY_RTDN_OIDC_AUDIENCE=

# Play subscription reconciliation (safety net for missed RTDN)
# When enabled, periodically scans tenantBilling where billingProvider=play and heals state.
PLAY_BILLING_RECONCILE_ENABLED=0
# Default: 6 hours (min 60s, max 7d)
PLAY_BILLING_RECONCILE_INTERVAL_MS=21600000
# Run once shortly after startup (useful after deploys)
PLAY_BILLING_RECONCILE_RUN_ON_START=0
PLAY_BILLING_RECONCILE_START_DELAY_MS=30000
# Optional: target specific tenants (comma-separated tenant IDs)
# If set, only these tenants will be reconciled (up to PLAY_BILLING_RECONCILE_MAX_TENANTS).
PLAY_BILLING_RECONCILE_TENANT_IDS=
# Safety cap for auto-scan mode
PLAY_BILLING_RECONCILE_MAX_TENANTS=200
# Log-only mode (no writes)
PLAY_BILLING_RECONCILE_DRY_RUN=0
# Verbose logs (targets + skips)
PLAY_BILLING_RECONCILE_VERBOSE=0

# Recommended production baseline (example for ~10k Play subscribers, multi-machine deployment):
# PLAY_BILLING_RECONCILE_ENABLED=1
# PLAY_BILLING_RECONCILE_INTERVAL_MS=900000
# PLAY_BILLING_RECONCILE_RUN_ON_START=1
# PLAY_BILLING_RECONCILE_START_DELAY_MS=60000
# PLAY_BILLING_RECONCILE_MAX_TENANTS=500

# Distributed lock (recommended when running multiple machines)
# Prevents 20 machines from running reconciliation concurrently.
PLAY_BILLING_RECONCILE_LOCK_ENABLED=1
# Firestore lock doc path, format: collection/docId
PLAY_BILLING_RECONCILE_LOCK_DOC=billingLocks/play_billing_reconcile
# Lease duration (ms). Keep it >= worst-case reconcile duration.
PLAY_BILLING_RECONCILE_LOCK_LEASE_MS=900000

# Recommended production lease for larger batches (example):
# PLAY_BILLING_RECONCILE_LOCK_LEASE_MS=3600000

# App Store Billing (server-side only)
# App Store Server API key configuration
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_P8=
# Bundle ID / product IDs
APPSTORE_BUNDLE_ID=
APPSTORE_PRODUCT_ID_PRO_MONTHLY=

# CSP configuration
CSP_VIOLATION_RETENTION_DAYS=7
CSP_VIOLATION_PRUNE_INTERVAL_MS=3600000
CSP_HASHES_PATH=./csp-hashes.json
# Set to 1 to always include CSP Report-Only header
CSP_REPORT_ONLY_MODE=0

# Birthday notification scheduler (optional)
# Toggle the daily birthday-runner on/off (defaults to enabled when unset)
BIRTHDAY_NOTIFICATIONS_ENABLED=true
# Force an immediate run on service start (helpful for tests); default false
BIRTHDAY_NOTIFICATIONS_RUN_ON_START=true
# Delay in ms before the startup run triggers (defaults to 15000)
BIRTHDAY_NOTIFICATIONS_START_DELAY_MS=0
# Dry run mode logs intended deliveries without hitting Expo (default false)
BIRTHDAY_NOTIFICATIONS_DRY_RUN=false
# Emit completion stats to logs after each run (default disabled)
BIRTHDAY_NOTIFICATIONS_LOG_STATS=true
# Override sender name used in push messages; falls back to Firestore coachingName
BIRTHDAY_NOTIFICATION_SENDER_NAME="S.S Tuition Classes"
# Cache duration in ms for the coaching name lookup (default 300000)
BIRTHDAY_COACHING_NAME_CACHE_MS=300000

# Daily quote scheduler (optional)
# Toggle the daily quote notifications on/off (defaults to enabled when unset)
DAILY_QUOTES_ENABLED=true
# Scheduler mode:
# - time_of_day: run at DAILY_QUOTES_MORNING_* and DAILY_QUOTES_EVENING_* in DAILY_QUOTES_DEFAULT_TIMEZONE
# - interval: run every DAILY_QUOTES_INTERVAL_MS and send when a device is within its configured window
DAILY_QUOTES_SCHEDULER_MODE=time_of_day
# Default timezone used for the scheduler (device timezones can override delivery eligibility)
DAILY_QUOTES_DEFAULT_TIMEZONE=Asia/Kolkata
# Morning/Evening slot times (0-23 / 0-59)
DAILY_QUOTES_MORNING_HOUR=8
DAILY_QUOTES_MORNING_MINUTE=0
DAILY_QUOTES_EVENING_HOUR=20
DAILY_QUOTES_EVENING_MINUTE=0
# Delivery window in minutes after the slot time (per-device local time)
DAILY_QUOTES_WINDOW_MINUTES=90
# Interval mode frequency (ms)
DAILY_QUOTES_INTERVAL_MS=300000
# Optional: force a run shortly after startup (will still respect windows)
DAILY_QUOTES_RUN_ON_START=false
DAILY_QUOTES_START_DELAY_MS=15000
# If the service starts during the morning/evening window, run a one-time catch-up for that slot.
# This prevents missing quotes after deployments/restarts.
DAILY_QUOTES_CATCHUP_ON_START=true
DAILY_QUOTES_CATCHUP_DELAY_MS=10000
DAILY_QUOTES_WINDOW_EARLY_GRACE_SECONDS=10

# Usage analytics rollups (optional manual overrides)
# Comma-separated tenant IDs or leave blank to scan all tenants
USAGE_ROLLUP_TENANT_IDS=
# Format YYYY-MM for backfills; defaults to current month when unset
USAGE_ROLLUP_MONTH=
# Set to 1 to reprocess historical docs (backfill), defaults to 0
USAGE_ROLLUP_BACKFILL=0
# Set to 1 to skip writes, useful when validating queries locally
USAGE_ROLLUP_DRY_RUN=0
# Increase logging noise for targeted debugging (0 = concise)
USAGE_ROLLUP_VERBOSE=0
# Tag manual executions so Firestore records show a descriptive label
USAGE_ROLLUP_JOB_LABEL=usage_rollup_scheduler
# Helps attribute runs in Firestore (falls back to GITHUB_SHA/USER)
ROLLUP_RUNNER_ID=local-dev

# Billing backfill/reconciliation job (Razorpay)
# Comma-separated tenant IDs. Leave blank to auto-scan tenantBilling where billingProvider=razorpay.
BILLING_BACKFILL_TENANT_IDS=
# Safety limit for auto-scan mode (defaults applied when unset).
BILLING_BACKFILL_MAX_TENANTS=250
# Max Razorpay payments to fetch per subscription (paging supported, hard-capped).
BILLING_BACKFILL_MAX_PAYMENTS_PER_SUBSCRIPTION=200
# Set to 1 to skip writes (logs only)
BILLING_BACKFILL_DRY_RUN=0
# Set to 1 for verbose per-tenant logs
BILLING_BACKFILL_VERBOSE=0
# Tag executions so Firestore records show a descriptive label
BILLING_BACKFILL_JOB_LABEL=billing_backfill
# Helps attribute runs in Firestore
BILLING_BACKFILL_RUNNER_ID=local-dev

# Billing backfill scheduler (optional)
# When enabled, runs the backfill job periodically inside backend-runtime.
BILLING_BACKFILL_SCHEDULER_ENABLED=0
# Optional: run once shortly after startup
BILLING_BACKFILL_SCHEDULER_RUN_ON_START=0
BILLING_BACKFILL_SCHEDULER_START_DELAY_MS=30000
# Default: 24 hours
BILLING_BACKFILL_SCHEDULER_INTERVAL_MS=86400000
# Safety switch to log-only even when scheduler is enabled
BILLING_BACKFILL_SCHEDULER_DRY_RUN=0

# Billing stale-pending auto-cancel job (Cloud Run Job / manual)
# Cancels pending subscription attempts only after the threshold window (default 24h).
# Optional: target specific tenants (comma-separated tenant IDs). Targeted runs still respect cutoff.
BILLING_STALE_PENDING_TENANT_IDS=
# Safety cap for auto-scan mode
BILLING_STALE_PENDING_MAX_TENANTS=200
# Hours since checkout/invoice issuedAt before we auto-cancel (default 24; clamped 1..168 in code)
BILLING_STALE_PENDING_THRESHOLD_HOURS=24
# Set to 1 to skip writes (logs only)
BILLING_STALE_PENDING_DRY_RUN=0
# Set to 1 for verbose per-tenant logs
BILLING_STALE_PENDING_VERBOSE=0
# Tag executions so logs/Firestore records are attributable
BILLING_STALE_PENDING_JOB_LABEL=billing_stale_pending
# Per-tenant lease duration in ms (clamped 30s..30m; default 180000)
BILLING_STALE_PENDING_TENANT_LEASE_MS=180000

# Run-level lease (overlap protection) in ms (clamped 30s..6h by the runner parser; job clamps internally to 5m..6h).
# This prevents Cloud Scheduler from starting a second run while the previous is still executing.
# Recommended for 1000+ tenants: 2 hours.
BILLING_STALE_PENDING_RUN_LEASE_MS=7200000

# Metrics (optional)
# Comma-separated list of counter names to include in rolling-window calculations.
# Leave blank/unset to use the default billing allowlist from backend-runtime/src/metrics.ts.
METRICS_WINDOWED_NAMES=

# Usage refresh worker tuning
# Maximum refresh docs processed per invocation (sane default: 25)
USAGE_REFRESH_BATCH_LIMIT=25
# Set to 1 to only log intended work without updates
USAGE_REFRESH_DRY_RUN=0
# Set to 1 for verbose per-request logs
USAGE_REFRESH_VERBOSE=0

# Storage accounting controls
# Optional collection to mirror aggregate totals for analytics dashboards
USAGE_STORAGE_STATS_COLLECTION=usage_storage_stats
# Extra Firestore prefixes to scan (comma-separated), e.g. chats/messages/uploads
USAGE_STORAGE_EXTRA_PREFIXES=

# Usage alerting + escalation
# Friendly sender + product names for email/slack templates
USAGE_ALERT_SENDER_NAME="Usage Monitor"
USAGE_ALERT_BRAND_NAME="Tuition Manager"
# Hours to suppress repeat alerts for the same metric (min 1 hour)
USAGE_ALERT_THROTTLE_HOURS=24
# Emit debug-only alerts/logs even when thresholds not crossed
USAGE_ALERT_DEBUG=0
# Slack webhook required for escalations + broadcast alerts
USAGE_ALERT_SLACK_WEBHOOK_URL=
# Number of pending alerts to escalate per run (default 10)
USAGE_ALERT_ESCALATION_BATCH_LIMIT=10
# Max attempts before giving up on a specific alert escalation
USAGE_ALERT_ESCALATION_MAX_ATTEMPTS=3
# Warn stakeholders if an alert stays unacked for N hours
USAGE_ALERT_ACK_ESCALATION_WARNING_HOURS=12
# Escalate as critical after this many hours without acknowledgment
USAGE_ALERT_ACK_ESCALATION_CRITICAL_HOURS=24


DAILY_QUOTES_DEBUG_TOKEN=
DAILY_QUOTES_DEBUG_DEVICE_ID=
DAILY_QUOTES_DEBUG_EMAIL=


# DO NOT CHECK REAL SECRETS INTO VERSION CONTROL.

# ── Dependencies (reinstalled via `npm ci` in the build stage) ──
node_modules

# ── Build output (regenerated by `npm run build` inside the image) ──
dist
tsconfig.tsbuildinfo

# ── Separate admin-console frontend — NOT part of the backend runtime image ──
# (verified: the backend never serves it via express.static/sendFile)
admin-console

# ── Test coverage reports ──
coverage

# ── Emulator / integration test suites (not needed at runtime) ──
tests

# ── Secrets — never bake into the image (provided via Fly secrets / env at runtime) ──
.env
.env.*
!.env.example
firebase_sa.b64
*.b64

# ── Local runtime artifacts / logs ──
*.log
firebase-debug.log
firestore-debug.log
ui-debug.log
jobs-audit.json
jobs-audit-*.json

# ── VCS / editor / OS junk ──
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# ── Misc dev-only files not needed by the runtime image ──
*.md
eas.json
.eslintrc.cjs

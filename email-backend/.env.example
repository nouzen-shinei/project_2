# Email Backend Environment Example
PORT=8090

# Primary provider (ses | resend)
EMAIL_PROVIDER_PRIMARY=ses
EMAIL_PROVIDER_FALLBACK=resend
EMAIL_RATE_LIMIT_PER_MIN=600
EMAIL_DAILY_CAP=8000
WARMUP_START_TS=0
EMAIL_PER_KEY_DAILY_CAP=0
TZ=Asia/Kolkata
QUOTA_KEY_HEADER=x-internal-key
QUOTA_KEY_CLAIM=
QUOTA_JWT_VERIFY=0
QUOTA_JWT_ALG=RS256
QUOTA_JWT_PUBLIC_KEY=
QUOTA_JWT_PUBLIC_KEY_B64=
QUOTA_JWT_SECRET=

# Multi-tenant sender pools
DEFAULT_TENANT=
TENANT_HEADER=x-tenant
TENANT_CLAIM=
SENDER_POOLS_JSON={"schoolA":{"email":"noreply@schoolA.com","name":"School A"},"schoolB":{"email":"mail@schoolB.org"}}
TENANT_REQUIRED=0

# Admin per-IP rate limit
ADMIN_RATE_PER_MIN=120

# AWS SES
AWS_SES_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
SES_SENDER_EMAIL=no-reply@yourdomain.com
SES_SENDER_NAME="Tuition Management"

# Resend Fallback
RESEND_API_KEY=your_resend_api_key
RESEND_DOMAIN=mg.yourdomain.com
RESEND_WEBHOOK_SECRET=

# Optional future suppression / auth
INTERNAL_API_KEY=replace_with_internal_key
ASYNC_SENDS=0
SEND_LOG_FILE=./logs/sendlog.ndjson
GLOBAL_LIMIT_REDIS=0

# Redis (optional)
REDIS_URL=redis://localhost:6379
REDIS_RETRY_QUEUE=0

# Circuit breaker
PROVIDER_CB_FAILS=5
PROVIDER_CB_HALF_OPEN_MS=30000

# SNS webhook validation / auto-confirm
SNS_VALIDATE_SIGNATURE=1
SNS_AUTO_CONFIRM=1

# Audit logging & redaction
AUDIT_LOG_FILE=./logs/audit.log
AUDIT_REDACT_BODIES=1

# Canary test address
PING_EMAIL=you+canary@yourdomain.com

# Backend-runtime callback (for updating reminderHistory email status without Firebase access)
BACKEND_RUNTIME_URL=https://your-backend-runtime-host
BACKEND_RUNTIME_INTERNAL_KEY=
BACKEND_RUNTIME_CALLBACK_TIMEOUT_MS=3000

# Smart links (optional)
# If set, template URLs like action_url/alert_url/invite_link/admin_portal_url
# will be wrapped as: ${PUBLIC_WEB_APP_ORIGIN}/l?u=<original>&dl=<optional deep_link>
# This enables: open native app on mobile (via scheme) and fall back to web.
PUBLIC_WEB_APP_ORIGIN=https://tuitionmanager.app


# Persistence (optional but recommended)
PERSIST_DIR=./data
# 64 hex chars (32 bytes) for AES-256-GCM at-rest encryption
PERSIST_ENCRYPT_KEY=




